# Copy to data/install.env and fill in (data/ is never committed).
TUNNEL="cloudflare"             # "cloudflare", or "other" for Tailscale Funnel, ngrok…
HOST="mcp.example.com"          # public hostname of the connector
PORT="47851"
LABEL="local.claude-voice-mcp"  # LaunchAgent label

# Only for TUNNEL="cloudflare":
ZONE="example.com"              # Cloudflare zone of HOST
TUNNEL_ID="00000000-0000-0000-0000-000000000000"
ACCESS_TEAM="your-team"         # https://<team>.cloudflareaccess.com
ACCESS_EMAIL="you@example.com"  # the only account allowed to authorize the connector
ACCESS_IDP=""                   # optional identity provider id (skips the provider picker)
